# NEWS_SOURCES={"football":"https://feeds.bbci.co.uk/sport/football/rss.xml","tennis":"https://feeds.bbci.co.uk/sport/tennis/rss.xml"}
CATALOG_SERVICE_URL=http://catalog-svc:8000
