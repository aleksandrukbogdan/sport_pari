DATABASE_URL=postgresql+asyncpg://news:news@localhost:5432/news
USER_SERVICE_URL=http://user-svc:8000
TRUST_GATEWAY_HEADERS=false
PREVIEW_ENABLED=true
# Generate a private editor key for X-API-Key. Empty disables editor access.
