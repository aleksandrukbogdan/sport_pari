APP_ENV=test
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=sport-pari
KEYCLOAK_CLIENT_ID=user-svc
KEYCLOAK_CLIENT_SECRET=dev-secret-change-me

# PostgreSQL (same as Keycloak)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

# Scheduler
RUN_SCHEDULER=false

